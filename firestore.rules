rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funções auxiliares de segurança
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isMaster() {
      return isSignedIn() && (
        request.auth.token.email == 'slaitertripas@gmail.com'
      );
    }

    function getLoggedUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isGlobalAdmin() {
      return isMaster() || (isSignedIn() && getLoggedUser().isOwner == true);
    }

    // Regra para coleções que devem ser isoladas
    match /{collection}/{docId} {
      allow read, write: if isGlobalAdmin() || (isSignedIn() && (
        resource.data.tenantId == getLoggedUser().instituicaoId || 
        request.resource.data.tenantId == getLoggedUser().instituicaoId
      ));
    }
    
    // Regra para coleções públicas ou de usuários
    match /users/{userId} {
      allow read, write: if isGlobalAdmin() || isSignedIn() && request.auth.uid == userId;
    }
  }
}

